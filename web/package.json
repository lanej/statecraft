{
  "name": "statecraft",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:browser": "playwright test",
    "build": "tsc -b && vite build",
    "check": "biome ci . --error-on-warnings",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@bufbuild/buf": "1.57.2",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@playwright/test": "1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
